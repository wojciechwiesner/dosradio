GEMINI_API_KEY=your-gemini-key
DOSRADIO_SECRET=random-string-at-least-32-chars
DOSRADIO_DATA_DIR=/home/vizi/apps/dosradio-api/data
DOSRADIO_TRIAL_SECONDS=3600
DOSRADIO_NEWS_REFRESH=3600
# E-mail verification (SMTP with STARTTLS; Gmail app password works)
DOSRADIO_SMTP_HOST=smtp.gmail.com
DOSRADIO_SMTP_PORT=587
DOSRADIO_SMTP_USER=you@gmail.com
DOSRADIO_SMTP_PASS=your-app-password
DOSRADIO_SMTP_FROM=DOS Radio <you@gmail.com>
DOSRADIO_SITE_URL=https://dosradio.theones.io
# Stripe billing — DOS Radio Plus (TEST MODE keys only; never commit real keys)
STRIPE_SECRET_KEY=sk_test_your-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Stripe Price ID of the Plus plan (39 PLN/month); leave empty to pass the price inline
DOSRADIO_PLUS_PRICE_PLN=price_your-plus-price-id
